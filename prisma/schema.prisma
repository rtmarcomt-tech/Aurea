generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum MediaStatus {
  PROCESSING
  READY
  HIDDEN
  FAILED
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model SiteSettings {
  id             String   @id @default("site")
  siteName       String   @default("AureA")
  description    String   @default("")
  locale         String   @default("pt-PT")
  timezone       String   @default("Europe/Lisbon")
  contactEmail   String?
  contactPhone   String?
  address        String?
  socialLinks    Json?
  globalSeoTitle String?
  globalSeoDescription String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  revisions   PageRevision[]
  auditEvents AuditEvent[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  lastSeenAt DateTime?
  @@index([userId, expiresAt])
}

model Page {
  id              String         @id @default(cuid())
  key             String         @unique
  path            String         @unique
  status          PageStatus     @default(DRAFT)
  draftContent    Json
  publishedContent Json?
  seoTitle        String?
  seoDescription  String?
  canonicalUrl    String?
  publishedAt     DateTime?
  version         Int            @default(1)
  revisions       PageRevision[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PageRevision {
  id          String    @id @default(cuid())
  pageId      String
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  content     Json
  seoSnapshot Json?
  createdAt   DateTime  @default(now())
  @@index([pageId, createdAt])
}

model MediaAsset {
  id           String      @id @default(cuid())
  storageKey   String      @unique
  originalName String
  mimeType     String
  byteSize     Int
  width        Int?
  height       Int?
  variants     Json?
  altText      String      @default("")
  caption      String      @default("")
  status       MediaStatus @default(PROCESSING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  @@index([status, createdAt])
}

model ContactMessage {
  id          String               @id @default(cuid())
  name        String
  email       String
  subject     String?
  message     String
  status      ContactMessageStatus @default(NEW)
  riskSignals Json?
  receivedAt  DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@index([status, receivedAt])
}

model AuditEvent {
  id         String    @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  @@index([createdAt])
  @@index([entityType, entityId])
}

model RateLimitBucket {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}
