# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_SECRET=replace-with-a-long-random-secret-before-deployment

# Database
DATABASE_URL=postgresql://aurea:aurea@localhost:5432/aurea?schema=public

# One-time administrator bootstrap; disable after setup
ADMIN_BOOTSTRAP_SECRET=replace-with-a-separate-one-time-secret

# Media storage
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=./storage/media
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional email notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
